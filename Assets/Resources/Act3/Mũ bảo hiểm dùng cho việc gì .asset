  m_EditorClassIdentifier: 
  question: "M\u0169 b\u1EA3o hi\u1EC3m d\xF9ng cho vi\u1EC7c g\xEC ?"
  level: "Trung b\xECnh"
  answer:
  - "B\u1EA3o v\u1EC7 ph\u1EA7n \u0111\u1EA7u kh\u1ECFi b\u1ECB t\u1ED5n th\u01B0\u01A1ng
