  m_Script: {fileID: 11500000, guid: d1f8955727824ec4799d47c0ebdc3a40, type: 3}
  m_Name: "Th\xE0nh th\u1ECB l\xE0 khu v\u1EF1c nh\u01B0 th\u1EBF n\xE0o"
  m_EditorClassIdentifier: 
  question: "Th\xE0nh th\u1ECB l\xE0 khu v\u1EF1c nh\u01B0 th\u1EBF n\xE0o?"
  level: "Kh\xF3"
  answer:
  - "L\xE0 n\u01A1i c\xF3 m\u1EADt \u0111\u1ED9 d\xE2n s\u1ED1 cao, c\xF3 nhi\u1EC1u
    th\u01B0\u01A1ng \u0111i\u1EC3m v\xE0 c\xE1c ng\xE0nh d\u1ECBch v\u1EE5"
  - "L\xE0 n\u01A1i c\xF3 m\u1EADt \u0111\u1ED9 d\xE2n s\u1ED1 th\u1EA5p, c\xF3 nhi\u1EC1u
    th\u01B0\u01A1ng \u0111i\u1EC3m v\xE0 c\xE1c ng\xE0nh d\u1ECBch v\u1EE5"
  - "L\xE0 n\u01A1i c\xF3 m\u1EADt \u0111\u1ED9 d\xE2n s\u1ED1 cao, c\xF3 \xEDt th\u01B0\u01A1ng
    \u0111i\u1EC3m v\xE0 c\xE1c ng\xE0nh d\u1ECBch v\u1EE5"
  - "L\xE0 n\u01A1i c\xF3 m\u1EADt \u0111\u1ED9 d\xE2n s\u1ED1 th\u1EA5p, c\xF3 \xEDt
    th\u01B0\u01A1ng \u0111i\u1EC3m v\xE0 c\xE1c ng\xE0nh d\u1ECBch v\u1EE5"
