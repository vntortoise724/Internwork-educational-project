  m_EditorClassIdentifier: 
  question: "Ph\u01B0\u01A1ng ti\u1EC7n \u01B0u ti\xEAn bao g\u1ED3m nh\u1EEFng xe
    g\xEC ?"
  level: "Trung b\xECnh"
  answer:
  - "Xe qu\xE2n \u0111\u1ED9i, xe c\u1EE9u h\u1ECFa, xe c\u1EE9u th\u01B0\u01A1ng
    v\xE0 xe c\u1EE9u tr\u1EE3 kh\u1EA9n c\u1EA5p"
  - "Xe bu\xFDt, xe \xF4m, xe taxi "
  - "Xe \u0111i\u1EC7n, xe \u0111\u1EA1p, xe x\xEDch l\xF4"
  - "Xe m\xE1y, xe t\u1EA3i, xe r\u1ED3ng ph\u1EE5ng"
