  m_Name: "Ph\u01B0\u01A1ng ti\u1EC7n c\xF4ng c\u1ED9ng bao g\u1ED3m nh\u1EEFng ph\u01B0\u01A1ng
    ti\u1EC7n n\xE0o "
  m_EditorClassIdentifier: 
  question: "Ph\u01B0\u01A1ng ti\u1EC7n c\xF4ng c\u1ED9ng bao g\u1ED3m nh\u1EEFng
    ph\u01B0\u01A1ng ti\u1EC7n n\xE0o ?"
  level: "Trung b\xECnh"
  answer:
  - "Xe \xF4m, xe bus, xe taxi v\xE0 t\xE0u h\u1ECFa"
  - "Xe qu\xE2n \u0111\u1ED9i, xe c\u1EE9u h\u1ECFa, xe c\u1EE9u th\u01B0\u01A1ng"
  - "Xe g\u1EAFn m\xE1y, xe h\u01A1i, xe t\u1EA3i"
  - "Xe \u0111\u1EA1p, xe \u0111i\u1EC7n"
