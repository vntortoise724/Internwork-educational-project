  m_Name: "B\xF9ng binh l\xE0 g\xEC "
  m_EditorClassIdentifier: 
  question: "B\xF9ng binh l\xE0 g\xEC ?"
  level: "Kh\xF3"
  answer:
  - "L\xE0 m\u1ED9t n\xFAt giao \u0111i\u1EC3m c\u1EE7a \u0111\u01B0\u1EDDng c\xF3
    h\xECnh tr\xF2n, ph\u01B0\u01A1ng ti\u1EC7n \u0111i v\xE0o ph\u1EA3i di chuy\u1EC3n
    theo h\u01B0\u1EDBng ng\u01B0\u1EE3c kim \u0111\u1ED3ng h\u1ED3"
  - "L\xE0 m\u1ED9t n\xFAt giao \u0111i\u1EC3m c\u1EE7a \u0111\u01B0\u1EDDng c\xF3
    h\xECnh tr\xF2n, ph\u01B0\u01A1ng ti\u1EC7n \u0111i v\xE0o ph\u1EA3i di chuy\u1EC3n
    theo h\u01B0\u1EDBng chi\u1EC1u kim \u0111\u1ED3ng h\u1ED3"
  - "L\xE0 m\u1ED9t d\u1EA1ng ng\xE3 t\u01B0 kh\xF4ng c\xF3 \u0111\xE8n giao th\xF4ng"
  - "L\xE0 m\u1ED9t n\xFAt giao \u0111i\u1EC3m c\u1EE7a \u0111\u01B0\u1EDDng c\xF3
    h\xECnh tr\xF2n, ph\u01B0\u01A1ng ti\u1EC7n \u0111i v\xE0o c\xF3 th\u1EC3 di
    chuy\u1EC3n theo h\u01B0\u1EDBng t\xF9y \xFD"
